# Backend independente na Vercel Services: o Angular estático é servido pela CDN.
# O container não precisa compilar Node nem atender requisições JS/CSS.
FROM eclipse-temurin:21-jdk AS build
WORKDIR /src
COPY .mvn/ .mvn/
COPY mvnw pom.xml ./
COPY backend/ backend/
RUN sh mvnw --batch-mode -Dmaven.test.skip=true -pl backend package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build --chown=10001:10001 /src/backend/target/backend-0.1.0-SNAPSHOT.jar /app/application.jar
USER 10001:10001
EXPOSE 8080
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75.0"
ENTRYPOINT ["java","-jar","/app/application.jar"]
