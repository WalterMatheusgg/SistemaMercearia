POSTGRES_DB=ferragens
POSTGRES_USER=ferragens
POSTGRES_PASSWORD=local-only-change-this
DB_URL=jdbc:postgresql://localhost:5432/ferragens
DB_USERNAME=ferragens
DB_PASSWORD=local-only-change-this
SESSION_COOKIE_SECURE=false
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-local-password
# Full Docker application (port 8080). For npm start use http://localhost:4200 instead.
APP_PUBLIC_URL=http://localhost:8080
APP_PORT=8080
APP_JOBS_ENABLED=true
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=sistema@ferragens.local
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_SSL=false

# Assistente (opcional; não envie a chave para repositórios)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
